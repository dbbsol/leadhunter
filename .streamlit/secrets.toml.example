# Copie para .streamlit/secrets.toml (local) ou cole em "Secrets" no Streamlit Community Cloud.
# NUNCA faça commit do secrets.toml.

# ---------- Login Google (OpenID Connect) ----------
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # em produção: https://SEU-APP.streamlit.app/oauth2callback
cookie_secret = "TROQUE-POR-UMA-STRING-ALEATORIA-LONGA"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------- Configurações gerais ----------
ADMIN_SHEET_ID = "ID_DA_PLANILHA_ADMIN"        # planilha com abas CLIENTES e ASSINATURAS
ADMIN_EMAILS = ["seu-email@gmail.com"]          # quem acessa a área administrativa
GEMINI_API_KEY = "AIza..."                      # opcional: sem ela o sistema usa análise por regras
GEMINI_MODEL = "gemini-2.5-flash"               # confira o modelo/cota gratuita em aistudio.google.com
NOMINATIM_CONTACT = "seu-email@gmail.com"       # exigido pela política de uso do Nominatim/OSM
GEOAPIFY_API_KEY = "COLE_SUA_CHAVE_AQUI"        # busca de empresas (grátis em myprojects.geoapify.com); sem ela usa o Overpass, instável

# ---------- Conta de serviço Google (acesso às planilhas) ----------
# Compartilhe cada planilha (admin e de cada cliente) com o client_email abaixo como "Editor".
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "lead-hunter@SEU-PROJETO.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
